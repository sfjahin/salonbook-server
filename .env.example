# SalonBook API - environment variable names only.
# Copy to .env and fill in the values. Never commit the real .env file.

# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB (either MONGODB_URI, or DB_USER + DB_PASS + DB_HOST)
MONGODB_URI=
DB_USER=
DB_PASS=
DB_HOST=cluster0.q6px8ox.mongodb.net
DB_NAME=salonbookdb

# Shared between the Next.js client (token issuer) and this API (verifier)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Stripe (test mode keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Image hosting
IMGBB_API_KEY=
